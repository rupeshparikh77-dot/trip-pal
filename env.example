# Copy to .env for local runs, or set these in Render's dashboard.
# Leave blank to run in demo mode with sample data.

# Get free credentials at https://developers.amadeus.com (Self-Service).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# "test" (free sandbox) or "production". Keep "test" for the free tier.
AMADEUS_ENV=test

# Port is set automatically by Render; only needed for local runs.
PORT=3000
